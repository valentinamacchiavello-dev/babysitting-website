<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Little Angels | Babysitting</title>

<style>
:root {
  --navy: #101a38;
  --navy-light: #172443;
  --pink: #f2c6dc;
  --pink-light: #f8d9e8;
  --pink-dark: #d99ab9;
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  background: var(--navy);
  color: var(--pink);
  font-family: Arial, sans-serif;
  min-height: 100vh;
}

header {
  height: 82px;
  border-bottom: 1px solid var(--pink);
  display: flex;
  justify-content: flex-end;
  align-items: center;
  padding: 0 6%;
  position: relative;
  z-index: 10;
}

.menu-button {
  background: none;
  border: none;
  color: var(--pink);
  font-size: 38px;
  cursor: pointer;
  font-weight: 300;
}

nav {
  display: none;
  position: absolute;
  top: 70px;
  right: 6%;
  background: var(--navy-light);
  border: 1px solid var(--pink);
  padding: 24px;
  min-width: 210px;
  flex-direction: column;
  gap: 20px;
}

nav.show {
  display: flex;
}

nav a {
  color: var(--pink);
  text-decoration: none;
  font-size: 17px;
}

nav a:hover {
  color: white;
}

.page {
  display: none;
  min-height: calc(100vh - 82px);
}

.page.active {
  display: block;
}

h1, h2, h3 {
  font-family: Georgia, serif;
  font-weight: normal;
}

button {
  font-family: inherit;
}

/* HOME */

#home {
  position: relative;
  min-height: calc(100vh - 82px);
  overflow: hidden;
  text-align: center;
  display: none;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding: 55px 20px;
}

#home.active {
  display: flex;
}

.home-bow {
  position: absolute;
  top: 20px;
  left: 35px;
  font-size: 65px;
  color: var(--pink);
  transform: rotate(-15deg);
}

.home-star {
  position: absolute;
  font-size: 30px;
  color: var(--pink);
}

.star-one {
  top: 45px;
  left: 20%;
}

.star-two {
  bottom: 25%;
  left: 8%;
}

.star-three {
  bottom: 12%;
  right: 8%;
}

.home-title {
  font-size: clamp(43px, 9vw, 100px);
  line-height: 1.05;
  letter-spacing: 1px;
  margin-bottom: 22px;
}

.home-subtitle {
  font-size: clamp(16px, 3vw, 27px);
  letter-spacing: 2px;
  font-weight: bold;
}

.home-divider {
  width: min(85%, 850px);
  margin: 48px auto 30px;
  display: flex;
  align-items: center;
  gap: 20px;
}

.home-divider::before,
.home-divider::after {
  content: "";
  height: 1px;
  background: var(--pink);
  flex: 1;
}

.home-divider span {
  font-size: 32px;
}

.main-button {
  display: inline-block;
  background: var(--pink);
  color: var(--navy);
  border: none;
  border-radius: 50px;
  padding: 20px 45px;
  font-family: Georgia, serif;
  font-size: 21px;
  cursor: pointer;
  text-decoration: none;
  transition: 0.2s;
}

.main-button:hover {
  background: white;
  transform: translateY(-2px);
}

.home-footer {
  margin-top: 45px;
  font-family: Georgia, serif;
  font-style: italic;
  font-size: 21px;
}

/* GENERAL PAGES */

.content {
  max-width: 1050px;
  margin: auto;
  padding: 75px 7%;
}

.page-title {
  font-size: clamp(42px, 8vw, 76px);
  text-align: center;
  margin-bottom: 55px;
}

.description {
  font-size: 19px;
  line-height: 1.9;
  max-width: 850px;
  margin: auto;
}

.panel {
  background: var(--navy-light);
  border: 1px solid var(--pink);
  border-radius: 15px;
  padding: 28px;
  margin: 25px 0;
}

.panel h3 {
  font-size: 25px;
  margin-bottom: 13px;
}

.panel p {
  font-size: 18px;
  line-height: 1.8;
}

.about-note {
  margin-top: 28px;
  text-align: center;
  font-family: Georgia, serif;
  font-style: italic;
}

/* SCHEDULES */

.schedule-card {
  text-align: center;
  padding: 30px;
}

.schedule-card h3 {
  font-size: 29px;
}

.schedule-card p {
  font-size: 18px;
}

/* REVIEWS */

.review-form {
  width: 100%;
}

.review-input,
.review-textarea {
  display: block;
  width: 100%;
  background: transparent;
  color: var(--pink);
  border: 2px solid var(--pink);
  border-radius: 14px;
  padding: 18px 22px;
  font-size: 18px;
  font-family: Arial, sans-serif;
  margin-bottom: 18px;
  outline: none;
}

.review-input::placeholder,
.review-textarea::placeholder {
  color: var(--pink);
  opacity: 0.9;
}

.review-textarea {
  min-height: 135px;
  resize: vertical;
}

.post-row {
  display: flex;
  justify-content: flex-end;
}

.post-button {
  background: var(--pink);
  color: var(--navy);
  border: none;
  border-radius: 40px;
  padding: 14px 48px;
  font-size: 19px;
  cursor: pointer;
}

.review-list {
  margin-top: 32px;
}

.empty-reviews {
  border: 2px solid var(--pink);
  border-radius: 15px;
  padding: 48px 20px;
  text-align: center;
  font-size: 20px;
}

.review-card {
  border: 1px solid var(--pink);
  border-radius: 15px;
  padding: 24px;
  margin-bottom: 18px;
  background: var(--navy-light);
}

.review-card h3 {
  font-size: 23px;
  margin-bottom: 10px;
}

.review-card p {
  font-size: 18px;
  line-height: 1.7;
  overflow-wrap: anywhere;
}

.review-help {
  text-align: center;
  margin-top: 24px;
}

.tutorial-link {
  background: none;
  color: var(--pink);
  border: none;
  text-decoration: underline;
  cursor: pointer;
  font-size: 15px;
}

/* TUTORIAL */

.tutorial-overlay {
  display: none;
  position: fixed;
  inset: 0;
  z-index: 30;
  background: rgba(3, 8, 25, 0.82);
  align-items: center;
  justify-content: center;
  padding: 20px;
}

.tutorial-overlay.show {
  display: flex;
}

.tutorial-box {
  max-width: 490px;
  width: 100%;
  padding: 30px;
  border: 2px solid var(--pink);
  border-radius: 16px;
  background: var(--navy);
  text-align: center;
  box-shadow: 0 0 25px rgba(242, 198, 220, 0.35);
}

.tutorial-box h3 {
  font-size: 27px;
  margin-bottom: 18px;
}

.tutorial-box p {
  font-size: 17px;
  line-height: 1.7;
}

.tutorial-box button {
  margin-top: 22px;
  background: var(--pink);
  color: var(--navy);
  border: none;
  border-radius: 30px;
  padding: 12px 25px;
  cursor: pointer;
  font-size: 16px;
}

.demo-review {
  text-align: left;
  margin-top: 16px;
  padding: 16px;
  border: 1px solid var(--pink);
  border-radius: 10px;
  font-size: 15px;
}

.demo-label {
  font-size: 12px !important;
  opacity: 0.75;
  margin-top: 15px;
}

.demo-reply {
  display: none;
  text-align: left;
  border: 1px solid var(--pink);
  border-radius: 10px;
  padding: 15px;
  margin-top: 12px;
  line-height: 1.6;
}

.demo-reply.show {
  display: block;
}

/* CONTACT */

.location-title {
  font-family: Georgia, serif;
  font-size: 30px;
  text-align: center;
  margin-bottom: 12px;
}

.location-text {
  font-family: Georgia, serif;
  font-style: italic;
  text-align: center;
  font-size: clamp(18px, 3vw, 27px);
  line-height: 1.7;
}

.whatsapp-area {
  text-align: center;
  margin: 55px 0;
}

.whatsapp-button {
  background: var(--pink);
  color: var(--navy);
  border: none;
  border-radius: 50px;
  padding: 19px 38px;
  font-size: 21px;
  cursor: pointer;
}

.contact-divider {
  display: flex;
  align-items: center;
  gap: 20px;
  margin: 50px 0 25px;
}

.contact-divider::before,
.contact-divider::after {
  content: "";
  height: 1px;
  flex: 1;
  background: var(--pink);
}

.contact-divider span {
  font-size: 30px;
}

.contact-message {
  font-family: Georgia, serif;
  font-style: italic;
  font-size: clamp(19px, 3vw, 27px);
  text-align: center;
}

/* FOOTER */

footer {
  text-align: center;
  padding: 25px;
  color: var(--pink);
  font-family: Georgia, serif;
  font-style: italic;
  font-size: 15px;
}

@media (max-width: 600px) {
  header {
    height: 70px;
  }

  .content {
    padding: 50px 6%;
  }

  .page-title {
    margin-bottom: 35px;
  }

  .home-bow {
    font-size: 42px;
  }

  .main-button {
    padding: 16px 25px;
    font-size: 17px;
  }

  .panel {
    padding: 22px;
  }
}
</style>
</head>

<body>

<header>
  <button class="menu-button" onclick="toggleMenu()" aria-label="Open menu">
    ☰
  </button>

  <nav id="menu">
    <a href="#" onclick="showPage('about'); return false;">About Me</a>
    <a href="#" onclick="showPage('schedules'); return false;">Schedules</a>
    <a href="#" onclick="showPage('reviews'); return false;">Parents Reviews</a>
    <a href="#" onclick="showPage('contact'); return false;">Contact Info</a>
  </nav>
</header>

<main>

<!-- HOME -->

<section id="home" class="page active">

  <div class="home-bow">୨୧</div>
  <span class="home-star star-one">✦</span>
  <span class="home-star star-two">✦</span>
  <span class="home-star star-three">✦</span>

  <h1 class="home-title">HELLO PARENTS!!</h1>

  <p class="home-subtitle">
    welcome to my Babysitting website!!
  </p>

  <div class="home-divider">
    <span>୨୧</span>
  </div>

  <button class="main-button" onclick="showPage('about')">
    GET TO KNOW ME →
  </button>

  <p class="home-footer">
    ♡ Little moments, lovely memories ♡
  </p>

</section>

<!-- ABOUT ME -->

<section id="about" class="page">
  <div class="content">

    <h2 class="page-title">About Me</h2>

    <p class="description">
      Hello!! I'm Valentina! I'm a friendly and caring babysitter
      with experience looking after children. I have three younger
      brothers, and I truly enjoy taking care of others.
      I would be very happy to meet you and your family!
    </p>

    <div class="panel">
      <h3>A little about me ♡</h3>
      <p>
        • I have three younger brothers.<br>
        • I've looked after children before.<br>
        • I genuinely enjoy caring for others.
      </p>
    </div>

    <p class="about-note">(˶ᵔ ᵕ ᵔ˶) ♡</p>

  </div>
</section>

<!-- SCHEDULES -->

<section id="schedules" class="page">
  <div class="content">

    <h2 class="page-title">Schedules</h2>

    <div class="panel schedule-card">
      <h3>Friday</h3>
      <p>Evening availability, subject to confirmation.</p>
    </div>

    <div class="panel schedule-card">
      <h3>Saturday</h3>
      <p>Availability can be confirmed with my parent/guardian.</p>
    </div>

    <div class="panel schedule-card">
      <h3>School Holidays</h3>
      <p>Subject to availability.</p>
    </div>

  </div>
</section>

<!-- PARENTS REVIEWS -->

<section id="reviews" class="page">
  <div class="content">

    <h2 class="page-title">PARENTS REVIEWS</h2>

    <form class="review-form" onsubmit="sendReview(event)">

      <input
        class="review-input"
        id="username"
        type="text"
        maxlength="30"
        placeholder="Write a username to comment"
        required
      >

      <textarea
        class="review-textarea"
        id="comment"
        maxlength="500"
        placeholder="Write your comment here..."
        required
      ></textarea>

      <div class="post-row">
        <button class="post-button" type="submit">Post</button>
      </div>

    </form>

    <div class="review-list" id="reviewList">
      <div class="empty-reviews">No reviews yet.</div>
    </div>

    <div class="review-help">
      <button class="tutorial-link" onclick="startTutorial()">
        How do Parents Reviews work?
      </button>
    </div>

  </div>
</section>

<!-- CONTACT INFO -->

<section id="contact" class="page">
  <div class="content">

    <h2 class="page-title">CONTACT INFO</h2>

    <div class="location-title">⌖ Location</div>

    <p class="location-text">
      Local babysitting in the surrounding neighbourhood.
    </p>

    <div class="whatsapp-area">
      <button class="whatsapp-button" onclick="openWhatsApp()">
        ☏ WhatsApp Contact
      </button>
    </div>

    <div class="contact-divider">
      <span>୨୧</span>
    </div>

    <p class="contact-message">
      Have any questions? Feel free to contact us! ♡
    </p>

  </div>
</section>

</main>

<footer>
  Little moments, lovely memories ♡
</footer>

<!-- REVIEWS TUTORIAL -->

<div class="tutorial-overlay" id="tutorialOverlay">
  <div class="tutorial-box" id="tutorialBox">
    <h3 id="tutorialTitle">Hello parents!</h3>
    <p id="tutorialText">
      Did you use my service? Do you have a question?
      Use the Parents Reviews and make a comment!
    </p>
    <button id="tutorialNext" onclick="nextTutorial()">Next →</button>
  </div>
</div>

<script>

/* NAVIGATION */

function toggleMenu() {
  document.getElementById("menu").classList.toggle("show");
}

function showPage(page) {
  document.querySelectorAll(".page").forEach(section => {
    section.classList.remove("active");
  });

  document.getElementById(page).classList.add("active");
  document.getElementById("menu").classList.remove("show");

  window.scrollTo({ top: 0, behavior: "smooth" });
}

/* CONTACT SETTINGS */

/* A parent/guardian should add their WhatsApp number here.
   Use country code, without +, spaces or dashes. */

const PARENT_WHATSAPP = "44XXXXXXXXXX";

function openWhatsApp() {
  if (PARENT_WHATSAPP.includes("X")) {
    alert("The parent/guardian WhatsApp contact has not been configured yet.");
    return;
  }

  window.open(
    "https://wa.me/" + PARENT_WHATSAPP,
    "_blank",
    "noopener,noreferrer"
  );
}

/* REVIEWS */

/*
  Approved reviews can be added here by a parent/guardian.
  The list starts empty: no invented reviews.
  GitHub Pages does not store public submissions by itself.
*/

const approvedReviews = [];

function displayReviews() {
  const list = document.getElementById("reviewList");

  if (approvedReviews.length === 0) {
    list.innerHTML = '<div class="empty-reviews">No reviews yet.</div>';
    return;
  }

  list.innerHTML = "";

  approvedReviews.forEach(review => {
    const card = document.createElement("div");
    card.className = "review-card";

    const name = document.createElement("h3");
    name.textContent = review.username;

    const comment = document.createElement("p");
    comment.textContent = review.comment;

    card.appendChild(name);
    card.appendChild(comment);
    list.appendChild(card);
  });
}

function sendReview(event) {
  event.preventDefault();

  const username = document.getElementById("username").value.trim();
  const comment = document.getElementById("comment").value.trim();

  if (!username || !comment) {
    alert("Please enter a username and a comment.");
    return;
  }

  if (PARENT_WHATSAPP.includes("X")) {
    alert("The parent/guardian contact has not been configured yet. Please ask them to set it up.");
    return;
  }

  const message =
    "Parents Reviews submission for approval\n\n" +
    "Username: " + username + "\n" +
    "Comment: " + comment;

  const link =
    "https://wa.me/" + PARENT_WHATSAPP +
    "?text=" + encodeURIComponent(message);

  window.open(link, "_blank", "noopener,noreferrer");

  alert("Your review has been sent for parent/guardian approval. It will not appear publicly until approved.");

  document.getElementById("username").value = "";
  document.getElementById("comment").value = "";
}

displayReviews();

/* REVIEWS TUTORIAL */

let tutorialStep = 0;

function startTutorial() {
  tutorialStep = 0;
  document.getElementById("tutorialOverlay").classList.add("show");
  updateTutorial();
}

function updateTutorial() {
  const title = document.getElementById("tutorialTitle");
  const text = document.getElementById("tutorialText");
  const next = document.getElementById("tutorialNext");
  const box = document.getElementById("tutorialBox");

  box.innerHTML = "";

  const heading = document.createElement("h3");
  const paragraph = document.createElement("p");
  const button = document.createElement("button");

  if (tutorialStep === 0) {
    heading.textContent = "Hello parents!";
    paragraph.textContent =
      "Did you use my service? Do you have a question? Use the Parents Reviews and make a comment!";
    button.textContent = "Next →";
    button.onclick = nextTutorial;
  }

  if (tutorialStep === 1) {
    heading.textContent = "Write your comment";
    paragraph.textContent =
      "Write a username and your comment, then press Post. Your review will be sent for approval.";
    button.textContent = "Next →";
    button.onclick = nextTutorial;
  }

  if (tutorialStep === 2) {
    heading.textContent = "Example review (tutorial only)";

    paragraph.textContent =
      "The following comments are demonstrations, not real reviews.";

    const first = document.createElement("div");
    first.className = "demo-review";
    first.textContent = "Example username: Nice service, will contact again!";

    const second = document.createElement("div");
    second.className = "demo-review";
    second.textContent =
      "Example username: Do you know if you can contact outside the local area? My friend needs one!";

    const instruction = document.createElement("p");
    instruction.style.marginTop = "15px";
    instruction.textContent =
      "Have you seen a question you can respond to? Tap Respond and help others!";

    const replyButton = document.createElement("button");
    replyButton.textContent = "Respond";
    replyButton.onclick = function() {
      replyButton.disabled = true;
      replyButton.textContent = "Responding...";

      const reply = document.createElement("div");
      reply.className = "demo-reply";
      reply.textContent =
        "Example reply: Hey! In Contact Info it says that she only babysits locally. If you need more help, you can message her on the WhatsApp contact in the Contact Info section in the menu!";

      box.appendChild(reply);

      setTimeout(() => {
        reply.classList.add("show");
        replyButton.textContent = "Example completed";
        button.textContent = "Finish";
        button.onclick = closeTutorial;
      }, 700);
    };

    box.appendChild(heading);
    box.appendChild(paragraph);
    box.appendChild(first);
    box.appendChild(second);
    box.appendChild(instruction);
    box.appendChild(replyButton);
    box.appendChild(button);
    return;
  }

  if (tutorialStep === 3) {
    closeTutorial();
    return;
  }

  box.appendChild(heading);
  box.appendChild(paragraph);
  box.appendChild(button);
}

function nextTutorial() {
  tutorialStep++;
  updateTutorial();
}

function closeTutorial() {
  document.getElementById("tutorialOverlay").classList.remove("show");
}

</script>

</body>
</html>
