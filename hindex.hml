<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Little Angels | Babysitting</title>

<style>
:root {
  --navy: #10152d;
  --navy-light: #1a2140;
  --pink: #edb6ce;
  --pink-light: #f8dce8;
  --white: #fff9fc;
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  background: var(--navy);
  color: var(--pink-light);
  font-family: Georgia, "Times New Roman", serif;
  min-height: 100vh;
}

button, input, textarea {
  font: inherit;
}

button {
  cursor: pointer;
}

/* NAVIGATION */

header {
  width: 100%;
  padding: 25px 7%;
  display: flex;
  justify-content: flex-end;
  align-items: center;
  position: relative;
  z-index: 20;
}

.menu-button {
  background: transparent;
  border: none;
  color: var(--pink);
  font-size: 34px;
  cursor: pointer;
}

.menu {
  display: none;
  position: absolute;
  top: 75px;
  right: 7%;
  width: 220px;
  background: var(--navy-light);
  border: 1px solid var(--pink);
  padding: 15px;
  z-index: 30;
}

.menu.open {
  display: block;
}

.menu a {
  display: block;
  color: var(--pink-light);
  text-decoration: none;
  padding: 13px 10px;
  font-size: 17px;
  border-bottom: 1px solid rgba(237,182,206,.2);
}

.menu a:last-child {
  border-bottom: none;
}

.menu a:hover {
  color: white;
}

/* GENERAL SECTIONS */

.page {
  display: none;
  min-height: calc(100vh - 80px);
  padding: 65px 9% 90px;
  animation: appear .5s ease;
}

.page.active {
  display: block;
}

@keyframes appear {
  from { opacity: 0; transform: translateY(8px); }
  to { opacity: 1; transform: translateY(0); }
}

h1, h2 {
  color: var(--pink);
  font-weight: normal;
}

h1 {
  font-size: clamp(42px, 8vw, 76px);
  letter-spacing: 1px;
}

h2 {
  font-size: clamp(36px, 6vw, 55px);
  margin-bottom: 30px;
}

p {
  line-height: 1.9;
  font-size: 18px;
}

.pink-line {
  width: 75px;
  height: 1px;
  background: var(--pink);
  margin: 25px 0;
}

/* HOME */

.home-content {
  max-width: 850px;
  margin: 75px auto 0;
}

.home-content h1 {
  text-align: left;
}

.subtitle {
  font-size: clamp(19px, 3vw, 25px);
  color: var(--pink-light);
  margin-top: 12px;
}

.main-button {
  display: inline-block;
  margin-top: 38px;
  padding: 14px 28px;
  color: var(--navy);
  background: var(--pink);
  border: 1px solid var(--pink);
  text-decoration: none;
  letter-spacing: 1px;
  font-size: 14px;
  transition: .25s;
}

.main-button:hover {
  background: transparent;
  color: var(--pink);
}

/* ABOUT */

.content-card {
  max-width: 760px;
  border: 1px solid rgba(237,182,206,.45);
  padding: 35px;
  margin-top: 25px;
  background: rgba(255,255,255,.015);
}

.content-card p {
  margin-bottom: 20px;
}

.content-card ul {
  padding-left: 22px;
  line-height: 2.2;
  font-size: 17px;
}

/* SCHEDULES */

.schedule-list {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 20px;
  margin-top: 35px;
}

.schedule-card {
  border: 1px solid rgba(237,182,206,.55);
  padding: 28px;
  min-height: 170px;
  background: var(--navy-light);
}

.schedule-card h3 {
  color: var(--pink);
  font-size: 24px;
  font-weight: normal;
  margin-bottom: 15px;
}

.schedule-card p {
  font-size: 16px;
}

/* REVIEWS */

.reviews-intro {
  max-width: 700px;
  margin-bottom: 30px;
}

.review-form {
  max-width: 700px;
  display: flex;
  flex-direction: column;
  gap: 15px;
  margin-top: 25px;
}

.review-form input,
.review-form textarea {
  width: 100%;
  background: transparent;
  border: 1px solid var(--pink);
  color: white;
  padding: 16px;
  outline: none;
  font-size: 16px;
}

.review-form input::placeholder,
.review-form textarea::placeholder {
  color: #d8b6c6;
}

.review-form textarea {
  min-height: 130px;
  resize: vertical;
}

.post-button {
  align-self: flex-start;
  background: var(--pink);
  color: var(--navy);
  border: 1px solid var(--pink);
  padding: 13px 35px;
  font-size: 16px;
  transition: .2s;
}

.post-button:hover {
  color: var(--pink);
  background: transparent;
}

.review-notice {
  color: var(--pink-light);
  font-size: 14px;
  margin-top: 5px;
}

.empty-reviews {
  border: 1px solid rgba(237,182,206,.55);
  padding: 50px 20px;
  margin-top: 45px;
  text-align: center;
  color: var(--pink);
  font-size: 20px;
  max-width: 700px;
}

/* CINEMATIC DEMO */

.tour-start {
  margin-top: 20px;
  background: transparent;
  border: 1px solid var(--pink);
  color: var(--pink);
  padding: 12px 20px;
}

.tour-overlay {
  display: none;
  position: fixed;
  inset: 0;
  background: rgba(3,5,17,.84);
  z-index: 100;
}

.tour-overlay.show {
  display: block;
}

.tour-spotlight {
  position: relative;
  z-index: 102;
  outline: 2px solid var(--pink);
  box-shadow: 0 0 0 9999px rgba(3,5,17,.84);
  border-radius: 3px;
}

.tour-message {
  position: fixed;
  z-index: 110;
  left: 50%;
  bottom: 35px;
  transform: translateX(-50%);
  width: min(90%, 550px);
  background: var(--navy-light);
  border: 1px solid var(--pink);
  color: var(--pink-light);
  padding: 24px;
  text-align: center;
  box-shadow: 0 10px 35px rgba(0,0,0,.4);
}

.tour-message p {
  font-size: 17px;
}

.tour-message button {
  margin-top: 15px;
  background: var(--pink);
  color: var(--navy);
  border: none;
  padding: 10px 22px;
}

.demo-comments {
  display: none;
  max-width: 700px;
  margin-top: 25px;
  gap: 15px;
  flex-direction: column;
}

.demo-comments.show {
  display: flex;
}

.demo-comment {
  border: 1px solid var(--pink);
  padding: 20px;
  background: var(--navy-light);
}

.demo-comment strong {
  color: var(--pink);
}

.respond-button {
  margin-top: 12px;
  background: transparent;
  border: 1px solid var(--pink);
  color: var(--pink);
  padding: 8px 16px;
}

.demo-reply {
  display: none;
  margin-top: 15px;
  padding: 15px;
  border-left: 2px solid var(--pink);
  color: var(--pink-light);
  line-height: 1.7;
}

.demo-reply.show {
  display: block;
}

/* CONTACT */

.contact-card {
  max-width: 650px;
  border: 1px solid rgba(237,182,206,.55);
  padding: 35px;
  margin-top: 25px;
  background: var(--navy-light);
}

.contact-card h3 {
  color: var(--pink);
  font-size: 23px;
  font-weight: normal;
  margin-bottom: 15px;
}

.contact-card .main-button {
  margin-top: 20px;
}

.contact-bottom {
  margin-top: 65px;
  text-align: center;
  color: var(--pink);
  font-style: italic;
}

/* FOOTER */

footer {
  text-align: center;
  padding: 25px;
  color: #d4a9bd;
  font-size: 13px;
  border-top: 1px solid rgba(237,182,206,.2);
}

@media (max-width: 600px) {
  .page {
    padding: 45px 7% 70px;
  }

  .home-content {
    margin-top: 55px;
  }

  .content-card, .contact-card {
    padding: 23px;
  }

  .tour-message {
    bottom: 20px;
  }
}
</style>
</head>

<body>

<header>
  <button class="menu-button" id="menuButton" aria-label="Open menu">☰</button>

  <nav class="menu" id="menu">
    <a href="#home" data-page="home">Home</a>
    <a href="#about" data-page="about">About Me</a>
    <a href="#schedules" data-page="schedules">Schedules</a>
    <a href="#reviews" data-page="reviews">Parents Reviews</a>
    <a href="#contact" data-page="contact">Contact Info</a>
  </nav>
</header>

<main>

<!-- HOME -->
<section class="page active" id="home">
  <div class="home-content" id="welcome">
    <h1>HELLO PARENTS!!</h1>
    <p class="subtitle">welcome to my Babysitting website!!</p>
    <div class="pink-line"></div>
    <p>
      A friendly and caring babysitting service for local families.
    </p>
    <a href="#about" class="main-button" data-page="about">
      GET TO KNOW ME
    </a>
  </div>
</section>

<!-- ABOUT ME -->
<section class="page" id="about">
  <h2>About Me</h2>
  <div class="pink-line"></div>

  <div class="content-card">
    <p>
      Hello!! I'm Valentina! I'm a friendly and caring babysitter
      with experience looking after children. I have three younger
      brothers, and I truly enjoy taking care of others.
      I would be very happy to meet you and your family!
    </p>

    <p><strong>A little about me:</strong></p>

    <ul>
      <li>I have three younger brothers.</li>
      <li>I've looked after children before.</li>
      <li>I genuinely enjoy caring for others.</li>
    </ul>
  </div>
</section>

<!-- SCHEDULES -->
<section class="page" id="schedules">
  <h2>Schedules</h2>
  <div class="pink-line"></div>

  <p>Here is when I may be available:</p>

  <div class="schedule-list">
    <div class="schedule-card">
      <h3>Fridays</h3>
      <p>Evenings, subject to confirmation.</p>
    </div>

    <div class="schedule-card">
      <h3>Saturdays</h3>
      <p>Availability can be confirmed by arrangement.</p>
    </div>

    <div class="schedule-card">
      <h3>School Holidays</h3>
      <p>Subject to availability.</p>
    </div>
  </div>
</section>

<!-- PARENTS REVIEWS -->
<section class="page" id="reviews">

  <h2>Parents Reviews</h2>
  <div class="pink-line"></div>

  <div class="reviews-intro" id="reviewWelcome">
    <p>
      Hello parents! Have you used my service?
      Do you have a question? You can leave a comment below!
    </p>
  </div>

  <form class="review-form" id="reviewForm">
    <input
      type="text"
      id="username"
      placeholder="Write a username to comment"
      required
    >

    <textarea
      id="comment"
      placeholder="Write your comment here..."
      required
    ></textarea>

    <button type="submit" class="post-button" id="postButton">
      Post
    </button>

    <p class="review-notice" id="reviewNotice">
      Comments will need adult approval before appearing publicly.
    </p>
  </form>

  <div class="empty-reviews" id="emptyReviews">
    No reviews yet.
  </div>

  <!-- CINEMATIC EXAMPLE COMMENTS: NOT REAL REVIEWS -->
  <div class="demo-comments" id="demoComments">

    <div class="demo-comment">
      <strong>Example comment</strong>
      <p>Nice service will contact again!</p>
    </div>

    <div class="demo-comment">
      <strong>Example comment</strong>
      <p>
        Do you know if you can contact outside the
        neighbourhood? My friend needs one.
      </p>

      <button class="respond-button" id="respondButton">
        Respond
      </button>

      <div class="demo-reply" id="demoReply"></div>
    </div>

  </div>

  <button class="tour-start" id="tourStart">
    See how it works
  </button>

</section>

<!-- CONTACT INFO -->
<section class="page" id="contact">
  <h2>Contact Info</h2>
  <div class="pink-line"></div>

  <div class="contact-card">
    <h3>Location</h3>
    <p>
      Local neighbourhoods only.
      Please ask a parent or guardian to confirm the service area.
    </p>

    <div class="pink-line"></div>

    <h3>WhatsApp Contact</h3>
    <p>
      For questions and booking enquiries, please contact
      the parent or guardian responsible for arrangements.
    </p>

    <!-- Replace the number below with an adult's approved WhatsApp number -->
    <a
      class="main-button"
      href="https://wa.me/440000000000"
      target="_blank"
      rel="noopener"
    >
      WHATSAPP CONTACT
    </a>
  </div>

  <div class="contact-bottom">
    Have any questions? Feel free to contact us! ♡
  </div>
</section>

</main>

<footer>
  Little Angels
</footer>

<!-- CINEMATIC OVERLAY -->
<div class="tour-overlay" id="tourOverlay"></div>

<div class="tour-message" id="tourMessage" style="display:none;">
  <p id="tourText"></p>
  <button id="tourNext">Continue</button>
</div>

<script>
/* MENU */

const menuButton = document.getElementById("menuButton");
const menu = document.getElementById("menu");

menuButton.addEventListener("click", () => {
  menu.classList.toggle("open");
});

function showPage(pageId) {
  document.querySelectorAll(".page").forEach(page => {
    page.classList.remove("active");
  });

  const selectedPage = document.getElementById(pageId);

  if (selectedPage) {
    selectedPage.classList.add("active");
  }

  menu.classList.remove("open");
  window.scrollTo({ top: 0, behavior: "smooth" });
}

document.querySelectorAll("[data-page]").forEach(link => {
  link.addEventListener("click", event => {
    event.preventDefault();
    showPage(link.dataset.page);
  });
});

/* REVIEWS FORM */

document.getElementById("reviewForm").addEventListener("submit", event => {
  event.preventDefault();

  document.getElementById("reviewNotice").textContent =
    "Thank you! This form still needs to be connected to an adult-managed review service before comments can be submitted.";

  document.getElementById("username").value = "";
  document.getElementById("comment").value = "";
});

/* CINEMATIC TUTORIAL */

const overlay = document.getElementById("tourOverlay");
const message = document.getElementById("tourMessage");
const tourText = document.getElementById("tourText");
const tourNext = document.getElementById("tourNext");

const reviewWelcome = document.getElementById("reviewWelcome");
const reviewForm = document.getElementById("reviewForm");
const demoComments = document.getElementById("demoComments");
const respondButton = document.getElementById("respondButton");
const demoReply = document.getElementById("demoReply");

let tourStep = 0;
let typingTimer;

const replyText =
  "Hey! In Contact Info it says that she only babysits locally. " +
  "If you need more help, you can message her on the WhatsApp " +
  "contact in the Contact Info section in the menu!";

function clearSpotlights() {
  document.querySelectorAll(".tour-spotlight").forEach(element => {
    element.classList.remove("tour-spotlight");
  });
}

function showTourMessage(text, buttonText = "Continue") {
  tourText.textContent = text;
  tourNext.textContent = buttonText;
  message.style.display = "block";
}

function startTour() {
  tourStep = 0;
  overlay.classList.add("show");
  demoComments.classList.add("show");
  demoReply.classList.remove("show");
  demoReply.textContent = "";
  showTourMessage(
    "Hello parents! Did you use my service? Do you have a question? Use the Parents Reviews and make a comment!!"
  );
  reviewWelcome.classList.add("tour-spotlight");
}

function nextTourStep() {
  clearSpotlights();
  tourStep++;

  if (tourStep === 1) {
    reviewForm.classList.add("tour-spotlight");
    showTourMessage("Write your comment and post it!!");
  }

  else if (tourStep === 2) {
    demoComments.classList.add("tour-spotlight");
    showTourMessage(
      "Here are two examples of the kinds of comments parents might leave."
    );
  }

  else if (tourStep === 3) {
    respondButton.classList.add("tour-spotlight");
    showTourMessage(
      "Have you seen a question you can respond? Tap respond and help others!!"
    );
  }

  else if (tourStep === 4) {
    showTourMessage("Watch how a response appears...", "");
    respondButton.classList.add("tour-spotlight");

    setTimeout(() => {
      demoReply.classList.add("show");
      demoReply.textContent = "";
      let index = 0;

      typingTimer = setInterval(() => {
        demoReply.textContent += replyText[index];
        index++;

        if (index >= replyText.length) {
          clearInterval(typingTimer);
          setTimeout(endTour, 2500);
        }
      }, 28);
    }, 1000);
  }
}

function endTour() {
  clearInterval(typingTimer);
  clearSpotlights();
  overlay.classList.remove("show");
  message.style.display = "none";
  demoComments.classList.remove("show");
}

document.getElementById("tourStart").addEventListener("click", startTour);
tourNext.addEventListener("click", nextTourStep);

overlay.addEventListener("click", endTour);
</script>

</body>
</html>
